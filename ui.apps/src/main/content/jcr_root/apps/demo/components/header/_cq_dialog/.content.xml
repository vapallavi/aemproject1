<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="House of Flowers Header"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <logo
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Logo"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                maximized="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <logoImage
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                fieldDescription="Optional DAM image. When empty, the botanical mark is shown beside the logo text."
                                                fieldLabel="Logo image"
                                                name="./logoImage"
                                                rootPath="/content/dam"/>
                                            <logoAlt
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldDescription="Required when the wordmark text is hidden and only the image is shown."
                                                fieldLabel="Logo alt text"
                                                name="./logoAlt"/>
                                            <logoText
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldDescription="Wordmark beside the mark or image. Leave empty to show the image only."
                                                fieldLabel="Logo text"
                                                name="./logoText"/>
                                            <logoLink
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                fieldDescription="Page the logo links to, typically the home page."
                                                fieldLabel="Logo link"
                                                name="./logoLink"
                                                rootPath="/content"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </logo>
                    <navigation
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Navigation Items"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <navItems
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldDescription="Add, remove, and reorder primary items. Enable a mega-menu on an item to author that item's panel in Mega Menu Settings below."
                                fieldLabel="Primary navigation">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./navItems">
                                    <items jcr:primaryType="nt:unstructured">
                                        <label
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Title"
                                            name="./label"
                                            required="{Boolean}true"/>
                                        <link
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldLabel="Link"
                                            name="./link"
                                            rootPath="/content"/>
                                        <opensMegaMenu
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                            fieldDescription="When checked, this item opens a mega-menu. Author the panel in the fields below."
                                            name="./opensMegaMenu"
                                            text="Enable mega-menu"
                                            uncheckedValue="{Boolean}false"
                                            value="{Boolean}true"/>
                                        <mega
                                            jcr:primaryType="nt:unstructured"
                                            jcr:title="Mega menu settings"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                                            <items jcr:primaryType="nt:unstructured">
                                                <introHeadline
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldLabel="Category headline"
                                                    name="./introHeadline"/>
                                                <introText
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                    fieldLabel="Category description"
                                                    name="./introText"
                                                    rows="{Long}4"/>
                                                <introCtaLabel
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldLabel="Primary CTA label"
                                                    name="./introCtaLabel"/>
                                                <introCtaLink
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                    fieldLabel="Primary CTA link"
                                                    name="./introCtaLink"
                                                    rootPath="/content"/>
                                                <megaColumns
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                    composite="{Boolean}true"
                                                    fieldDescription="Middle columns. Each section has a title and a list of links."
                                                    fieldLabel="Content sections">
                                                    <field
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/container"
                                                        name="./megaColumns">
                                                        <items jcr:primaryType="nt:unstructured">
                                                            <heading
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                fieldLabel="Section title"
                                                                name="./heading"
                                                                required="{Boolean}true"/>
                                                            <links
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                                composite="{Boolean}true"
                                                                fieldLabel="Links">
                                                                <field
                                                                    jcr:primaryType="nt:unstructured"
                                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                                    name="./links">
                                                                    <items jcr:primaryType="nt:unstructured">
                                                                        <label
                                                                            jcr:primaryType="nt:unstructured"
                                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                            fieldLabel="Label"
                                                                            name="./label"
                                                                            required="{Boolean}true"/>
                                                                        <link
                                                                            jcr:primaryType="nt:unstructured"
                                                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                            fieldLabel="Link"
                                                                            name="./link"
                                                                            rootPath="/content"/>
                                                                    </items>
                                                                </field>
                                                            </links>
                                                        </items>
                                                    </field>
                                                </megaColumns>
                                                <featuredHeading
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldLabel="Featured heading"
                                                    name="./featuredHeading"/>
                                                <featuredCards
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                    composite="{Boolean}true"
                                                    fieldDescription="Right-rail cards. Image, title, and link are required. Label is the small type kicker."
                                                    fieldLabel="Featured content cards">
                                                    <field
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/container"
                                                        name="./featuredCards">
                                                        <items jcr:primaryType="nt:unstructured">
                                                            <image
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                fieldLabel="Image"
                                                                name="./image"
                                                                required="{Boolean}true"
                                                                rootPath="/content/dam"/>
                                                            <title
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                fieldLabel="Title"
                                                                name="./title"
                                                                required="{Boolean}true"/>
                                                            <link
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                                fieldLabel="Link"
                                                                name="./link"
                                                                rootPath="/content"/>
                                                            <label
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                fieldLabel="Type / label"
                                                                name="./label"/>
                                                            <alt
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                                fieldDescription="Defaults to the card title when empty."
                                                                fieldLabel="Image alt text"
                                                                name="./alt"/>
                                                        </items>
                                                    </field>
                                                </featuredCards>
                                            </items>
                                        </mega>
                                    </items>
                                </field>
                            </navItems>
                        </items>
                    </navigation>
                    <megahint
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Mega Menu Settings"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <alert
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Per navigation item"
                                sling:resourceType="granite/ui/components/coral/foundation/alert"
                                text="Mega-menu panels are authored on each navigation item so Shop, About, Occasions, or any item can have its own panel. Open Navigation Items, tick Enable mega-menu, then fill Category headline, Content sections, and Featured content cards in that item's Mega menu settings."
                                variant="info"/>
                        </items>
                    </megahint>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
